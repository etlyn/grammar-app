# Optional explicit configuration for local or isolated account testing.
# Production uses the public Etlyn Apps configuration on www.grammacho.com.
# Never place database passwords, service-role keys or private tokens here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ETLYN_API_URL=https://api.etlyn.com
# false disables the optional account controls / Google entry respectively.
VITE_ACCOUNT_ENABLED=true
VITE_GOOGLE_AUTH_ENABLED=true
