{
  "name": "grammar-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-content.mjs && vite",
    "build": "node scripts/build-content.mjs && tsc --noEmit && vite build && node scripts/cache-build.mjs",
    "preview": "vite preview",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "content:build": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check",
    "content:sql": "node scripts/export-content-sql.mjs",
    "test": "node scripts/test.mjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "format": "prettier --write src/**/*.ts src/**/*.tsx content/*.mjs scripts/*.mjs tests/*.mjs tests/*.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.13",
    "postcss": "^8.4.38",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
